<header class="site-header" id="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/" aria-label="{{ site.name }} home">
      <svg class="brand__mark" viewBox="0 0 39 34" width="32" height="28" aria-hidden="true" focusable="false"><path fill="currentColor" d="M13.5 .5h13l12 21h-13zM6.5 11.5h14l-7 10-7 11-6.5-11zM13.5 22.5h13l6 11h-13z"/></svg>
      <span class="brand__name">{{ site.name }}</span><span class="brand__code">{{ code }}</span>
    </a>
    <div class="site-header__actions">
      <a class="btn btn--nav btn--solid" href="/contact/">Let's talk</a>
      <button class="btn btn--nav" id="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu"><span data-menu-label>Menu</span><span class="burger" aria-hidden="true"><i></i><i></i></span></button>
    </div>
  </div>
</header>
