{#-
  Standalone product layout for the webAgen landing page (webagen.html).
  Same <head> essentials as base.njk, but none of the Astro Synapse site
  chrome: no site header, menu, footer, product panel or organisation schema.
  Own header (webAgen wordmark + demo links) and a one-line footer.
  Front matter: title, description, ogImage, preloadImage (as in base.njk),
  plus `demo` (base URL of the live demos).
-#}
{%- set canonical = site.url + page.url -%}
{%- set og = site.ogImages[ogImage or "hero-space"] -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ canonical }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="webAgen">
<meta property="og:locale" content="{{ site.locale }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:image" content="{{ og.src | absoluteUrl }}">
<meta property="og:image:width" content="{{ og.width }}">
<meta property="og:image:height" content="{{ og.height }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="{{ site.themeColor }}">
<link rel="icon" href="/assets/images/logo-icon.svg" type="image/svg+xml">
<link rel="icon" href="/assets/images/icon-48.png" sizes="48x48" type="image/png">
<script>document.documentElement.classList.add("js")</script>
<link rel="preload" href="/assets/fonts/inter-var-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/satoshi-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/ibm-plex-mono-400-latin.woff2" as="font" type="font/woff2" crossorigin>
{%- if preloadImage %}
<link rel="preload" href="{{ preloadImage }}" as="image" fetchpriority="high">
{%- endif %}
<link rel="stylesheet" href="{{ '/assets/css/main.css' | rev }}">
<script src="{{ '/assets/js/main.js' | rev }}" defer></script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<div class="fx-grain" aria-hidden="true"></div>
<div class="fx-vignette" aria-hidden="true"></div>

{#- id="site-header" reuses the scroll state from main.js (solid background once scrolled) #}
<header class="site-header wa-header" id="site-header">
  <div class="wrap site-header__inner">
    <a class="wa-header__logo" href="#main" aria-label="webAgen, back to top">webAgen</a>
    <nav class="site-header__actions" aria-label="Demos">
      <a class="btn btn--nav btn--solid" href="{{ demo }}/website/" target="_blank" rel="noopener">Website<span class="wa-header__long">&nbsp;demo</span>&nbsp;↗</a>
      <a class="btn btn--nav btn--solid" href="{{ demo }}/webshop/" target="_blank" rel="noopener">Webshop<span class="wa-header__long">&nbsp;demo</span>&nbsp;↗</a>
    </nav>
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

<footer class="wa-footer">
  <div class="wrap wa-footer__inner">
    <p>Built by <a href="{{ site.url }}/">Astro Synapse ↗</a></p>
  </div>
</footer>
</body>
</html>
