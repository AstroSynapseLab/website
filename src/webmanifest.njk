---
permalink: /site.webmanifest
eleventyExcludeFromCollections: true
---
{
  "name": "{{ site.name }}",
  "short_name": "{{ site.name }}",
  "start_url": "{{ '/' | withBase }}",
  "display": "browser",
  "background_color": "{{ site.themeColor }}",
  "theme_color": "{{ site.themeColor }}",
  "icons": [
    { "src": "{{ '/assets/images/icon-192.png' | withBase }}", "sizes": "192x192", "type": "image/png" },
    { "src": "{{ '/assets/images/icon-512.png' | withBase }}", "sizes": "512x512", "type": "image/png" }
  ]
}
